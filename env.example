# ── Laurena OAuth2 (internal) ─────────────────────────────────────────────────
# URL of the main FastAPI backend (server-to-server, never exposed to browser)
LAURENA_API_URL=http://localhost:8000
# Shared secret between FastAPI (/oauth/token) and this Next.js backend.
# Must match OAUTH_TOKEN_SECRET in laurenastudio backend/.env
# Generate: openssl rand -hex 32
LAURENA_OAUTH_TOKEN_SECRET=
# URL of this builder app (shown in error pages / back-links)
NEXT_PUBLIC_MAIN_DOMAIN_URL=http://localhost:8080
